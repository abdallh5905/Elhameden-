    </div>

    <script>
        // تحديث السنة
        document.getElementById('year').textContent = new Date().getFullYear();

        // النص الدوار
        const rotatingLines = [
            "خدمة راقية وتنظيم مميز",
            "فنادق قريبة من الحرم بأسعار منافسة",
            "نقل مريح وباصات حديثة 2026",
            "دعم سريع عبر الواتساب والاتصال",
            "رحلات عمرة مباركة بإذن الله"
        ];
        let currentIndex = 0;
        const rotateEl = document.getElementById('rotateLine');
        setInterval(() => {
            currentIndex = (currentIndex + 1) % rotatingLines.length;
            rotateEl.style.opacity = '0';
            setTimeout(() => {
                rotateEl.textContent = rotatingLines[currentIndex];
                rotateEl.style.opacity = '1';
            }, 200);
        }, 3000);

        // القائمة المنبثقة
        const menuBtn = document.getElementById('menuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        const closeMenu = document.getElementById('closeMenu');

        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('show');
        });

        closeMenu.addEventListener('click', () => {
            mobileMenu.classList.remove('show');
        });

        // إغلاق القائمة عند النقر على رابط
        document.querySelectorAll('.mobile-menu .menu-item').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.remove('show');
            });
        });

        // إغلاق القائمة عند النقر خارجها
        document.addEventListener('click', (e) => {
            if (!mobileMenu.contains(e.target) && !menuBtn.contains(e.target)) {
                mobileMenu.classList.remove('show');
            }
        });

        // تمرير سلس
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });
    </script>
