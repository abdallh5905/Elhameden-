<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الحامدين للعمرة والزيارة - تصميم محسّن</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #0f172a;
            color: #e2e8f0;
            line-height: 1.6;
            overflow-x: hidden;
        }

        :root {
            --primary: #3b82f6;
            --primary-dark: #2563eb;
            --primary-light: #60a5fa;
            --secondary: #8b5cf6;
            --accent: #f59e0b;
            --dark: #0f172a;
            --darker: #020617;
            --light: #f8fafc;
            --gray: #94a3b8;
            --success: #10b981;
            --warning: #f59e0b;
            --glass-bg: rgba(255, 255, 255, 0.05);
            --glass-border: rgba(255, 255, 255, 0.1);
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* ===== header محسّن ===== */
        header {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--glass-border);
        }

        .nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 80px;
            position: relative;
        }

        /* توسيط اللوجو بشكل مطلق */
        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
        }

        .logo {
            width: 52px;
            height: 52px;
            background: linear-gradient(145deg, var(--primary), var(--secondary));
            border-radius: 16px;
            display: grid;
            place-items: center;
            box-shadow: 0 10px 20px -5px rgba(59, 130, 246, 0.3);
        }

        .logo i {
            font-size: 28px;
            color: white;
        }

        .brand .name {
            font-size: 24px;
            font-weight: 900;
            background: linear-gradient(to left, var(--primary-light), var(--secondary));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            letter-spacing: -0.5px;
        }

        /* الجهة اليسرى (القائمة) */
        .menu-btn {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            display: grid;
            place-items: center;
            cursor: pointer;
            transition: all 0.2s ease;
            color: var(--light);
            font-size: 1.4rem;
        }

        .menu-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: var(--primary);
        }

        /* الجهة اليمنى (الأزرار) */
        .nav-buttons {
            display: flex;
            gap: 12px;
            margin-right: auto; /* دفع الأزرار لليمين */
        }

        .nav-btn {
            padding: 10px 20px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 0.95rem;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
            border: 1px solid var(--glass-border);
            background: var(--glass-bg);
            color: var(--light);
        }

        .nav-btn:hover {
            background: var(--primary);
            border-color: var(--primary);
            transform: translateY(-2px);
        }

        /* ===== hero section ===== */
        .hero {
            min-height: 90vh;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
            margin-bottom: 40px; /* إضافة فاصل بين الهيرو والقسم التالي */
        }

        .hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 80%;
            height: 200%;
            background: radial-gradient(circle, rgba(59,130,246,0.15) 0%, transparent 70%);
            z-index: -1;
        }

        .hero-content {
            max-width: 900px;
            margin: 0 auto;
            text-align: center;
        }

        .pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 100px;
            font-weight: 700;
            margin-bottom: 30px;
            backdrop-filter: blur(10px);
        }

        .hero-title {
            font-size: clamp(40px, 8vw, 72px);
            font-weight: 900;
            line-height: 1.2;
            margin-bottom: 20px;
            background: linear-gradient(to left, #fff, var(--primary-light));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .hero-sub {
            font-size: clamp(16px, 3vw, 22px);
            color: var(--gray);
            max-width: 700px;
            margin: 0 auto 30px;
        }

        .hero-sub .hl {
            color: var(--primary-light);
            font-weight: 700;
        }

        .rotate-wrap {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 40px;
            font-size: 1.2rem;
        }

        .rotate-line {
            padding: 8px 24px;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 100px;
            transition: opacity 0.3s;
        }

        .hero-actions {
            display: flex;
            gap: 16px;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 50px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            border-radius: 14px;
            font-weight: 800;
            font-size: 1rem;
            text-decoration: none;
            transition: all 0.2s;
            border: none;
            cursor: pointer;
        }

        /* تعديل حجم الأزرار في الهيرو */
        .btn-primary {
            background: var(--primary);
            color: white;
            box-shadow: 0 10px 20px -5px rgba(59, 130, 246, 0.4);
            padding: 12px 28px; /* تصغير الحشو */
            font-size: 0.95rem;  /* تصغير الخط قليلاً */
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 15px 25px -5px rgba(59, 130, 246, 0.5);
        }

        .btn-wa {
            background: #25D366;
            color: white;
            box-shadow: 0 10px 20px -5px rgba(37, 211, 102, 0.3);
            padding: 12px 28px; /* نفس الحجم */
            font-size: 0.95rem;
        }

        .btn-wa:hover {
            background: #20bd5c;
            transform: translateY(-2px);
        }

        .hero-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            max-width: 800px;
            margin: 0 auto;
        }

        .hero-mini {
            padding: 16px 12px;
            border-radius: 16px;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            text-decoration: none;
            color: var(--light);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-weight: 700;
            transition: all 0.2s;
            backdrop-filter: blur(5px);
        }

        .hero-mini:hover {
            background: var(--primary);
            border-color: var(--primary);
            transform: translateY(-3px);
        }

        /* ===== عناوين الأقسام ===== */
        .section-head {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-head h2 {
            font-size: clamp(30px, 5vw, 48px);
            font-weight: 900;
            margin-bottom: 15px;
            background: linear-gradient(to left, #fff, var(--primary-light));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .section-head p {
            color: var(--gray);
            font-size: 1.2rem;
        }

        .line {
            width: 80px;
            height: 4px;
            background: linear-gradient(to right, var(--primary), var(--secondary));
            margin: 20px auto 0;
            border-radius: 4px;
        }

        /* ===== بطاقات عامة ===== */
        .glass-card {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            backdrop-filter: blur(10px);
            border-radius: 24px;
            padding: 30px;
            transition: transform 0.2s, border-color 0.2s;
        }

        .glass-card:hover {
            border-color: var(--primary);
            transform: translateY(-5px);
        }

        /* ===== قسم من نحن ===== */
        .about-card {
            padding: 40px;
            text-align: center;
        }

        .about-text {
            font-size: 1.2rem;
            color: var(--gray);
            max-width: 900px;
            margin: 0 auto 40px;
            line-height: 1.8;
        }

        .about-text .hl {
            color: var(--primary-light);
            font-weight: 700;
        }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .kpi-item {
            padding: 20px;
            background: rgba(255,255,255,0.03);
            border-radius: 20px;
        }

        .kpi-number {
            font-size: 2.5rem;
            font-weight: 900;
            color: var(--primary-light);
            margin-bottom: 5px;
        }

        .kpi-label {
            color: var(--gray);
            font-weight: 600;
        }

        /* ===== باقات ===== */
        .packages-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
        }

        .package-card {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            overflow: hidden;
            transition: all 0.2s;
        }

        .package-card:hover {
            border-color: var(--primary);
            transform: translateY(-5px);
        }

        .package-img {
            height: 220px;
            overflow: hidden;
        }

        .package-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s;
        }

        .package-card:hover .package-img img {
            transform: scale(1.05);
        }

        .package-content {
            padding: 24px;
        }

        .package-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .package-header h3 {
            font-size: 1.5rem;
            font-weight: 900;
        }

        .package-badges {
            display: flex;
            gap: 8px;
        }

        .badge {
            padding: 4px 12px;
            border-radius: 100px;
            font-size: 0.8rem;
            font-weight: 700;
            background: rgba(255,255,255,0.1);
            border: 1px solid var(--glass-border);
        }

        .badge.gold {
            background: rgba(245, 158, 11, 0.2);
            border-color: var(--accent);
            color: var(--accent);
        }

        .package-features {
            display: flex;
            gap: 16px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .package-features span {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--gray);
        }

        .package-features i {
            color: var(--primary-light);
        }

        .package-actions {
            display: flex;
            gap: 12px;
        }

        .package-actions .btn {
            flex: 1;
            padding: 12px;
            min-width: 0;
        }

        /* ===== النقل ===== */
        .transport-card {
            max-width: 900px;
            margin: 0 auto;
        }

        .route-box {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: 20px;
            background: rgba(0,0,0,0.2);
            border-radius: 20px;
            padding: 24px;
            margin: 20px 0;
        }

        .route-point {
            text-align: center;
        }

        .route-point .label {
            color: var(--gray);
            margin-bottom: 5px;
        }

        .route-point .city {
            font-size: 1.8rem;
            font-weight: 900;
        }

        .route-point .time {
            color: var(--gray);
            font-size: 0.9rem;
        }

        .route-arrow {
            font-size: 2rem;
            color: var(--primary-light);
        }

        .features-list {
            list-style: none;
            margin: 20px 0;
        }

        .features-list li {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }

        .features-list i {
            color: var(--success);
        }

        /* ===== تحسين السلايدر (الفنادق والباصات) ===== */
        .strip {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 30px;
            padding: 30px;
        }

        .strip-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .strip-header h3 {
            font-size: 1.8rem;
            font-weight: 900;
        }

        /* تحسين شريط التمرير */
        .strip-track {
            display: flex;
            gap: 24px;
            overflow-x: auto;
            padding: 10px 5px 20px;
            scroll-snap-type: x mandatory;
            scrollbar-width: thin;
            scrollbar-color: var(--primary) var(--glass-border);
        }

        .strip-track::-webkit-scrollbar {
            height: 10px;
        }

        .strip-track::-webkit-scrollbar-track {
            background: var(--glass-border);
            border-radius: 10px;
        }

        .strip-track::-webkit-scrollbar-thumb {
            background: var(--primary);
            border-radius: 10px;
        }

        .strip-track::-webkit-scrollbar-thumb:hover {
            background: var(--primary-dark);
        }

        /* بطاقات السلايدر */
        .strip-item {
            min-width: 320px; /* زيادة العرض */
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            overflow: hidden;
            transition: all 0.2s;
            scroll-snap-align: start;
            box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.3);
        }

        .strip-item:hover {
            border-color: var(--primary);
            transform: translateY(-5px);
            box-shadow: 0 20px 30px -5px rgba(59, 130, 246, 0.3);
        }

        .strip-item img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-bottom: 1px solid var(--glass-border);
        }

        .strip-body {
            padding: 20px;
        }

        .strip-body h4 {
            font-size: 1.3rem;
            margin-bottom: 8px;
            color: white;
        }

        .strip-body p {
            color: var(--gray);
            font-size: 0.95rem;
            margin-bottom: 15px;
            line-height: 1.5;
        }

        .strip-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .strip-footer span {
            color: var(--primary-light);
            display: flex;
            align-items: center;
            gap: 5px;
            font-weight: 600;
        }

        /* زر الواتساب في البطاقات - أيقونة فقط */
        .wa-icon-btn {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: #25D366;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.4rem;
            text-decoration: none;
            transition: all 0.2s;
            box-shadow: 0 5px 10px rgba(0,0,0,0.2);
        }

        .wa-icon-btn:hover {
            background: #20bd5c;
            transform: scale(1.1) rotate(5deg);
        }

        /* زر عرض الكل */
        .btn-sm {
            padding: 10px 20px;
            font-size: 0.9rem;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            color: var(--light);
            border-radius: 12px;
            text-decoration: none;
            transition: all 0.2s;
        }

        .btn-sm:hover {
            background: var(--primary);
            border-color: var(--primary);
        }

        /* ===== معرض الصور ===== */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
        }

        .gallery-item {
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid var(--glass-border);
            transition: all 0.2s;
            aspect-ratio: 4/3;
        }

        .gallery-item:hover {
            border-color: var(--primary);
            transform: scale(1.02);
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* ===== قسم الاتصال ===== */
        .contact-actions {
            display: flex;
            gap: 20px;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 40px;
        }

        .contact-info {
            max-width: 600px;
            margin: 0 auto;
            padding: 30px;
            border-radius: 30px;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            text-align: center;
        }

        .contact-info h3 {
            margin-bottom: 20px;
            color: var(--primary-light);
        }

        .contact-info p {
            margin: 15px 0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .contact-info a {
            color: var(--light);
            text-decoration: none;
        }

        .contact-info a:hover {
            color: var(--primary-light);
        }

        /* ===== الأزرار الثابتة ===== */
        .fixed-actions {
            position: fixed;
            bottom: 30px;
            left: 30px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            z-index: 99;
        }

        .fab {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            display: grid;
            place-items: center;
            text-decoration: none;
            color: white;
            font-size: 24px;
            transition: all 0.2s;
            box-shadow: 0 10px 20px rgba(0,0,0,0.3);
        }

        .fab.call {
            background: var(--primary);
        }

        .fab.wa {
            background: #25D366;
        }

        .fab:hover {
            transform: translateY(-5px) scale(1.1);
        }

        /* ===== تذييل ===== */
        footer {
            padding: 40px 0;
            border-top: 1px solid var(--glass-border);
            text-align: center;
            color: var(--gray);
        }

        /* ===== القائمة المنبثقة ===== */
        .mobile-menu {
            position: fixed;
            top: 90px;
            right: 20px;
            left: 20px;
            max-width: 400px;
            margin: 0 auto;
            background: var(--dark);
            border: 1px solid var(--glass-border);
            border-radius: 30px;
            padding: 25px;
            z-index: 1000;
            box-shadow: 0 25px 50px -10px black;
            display: none;
        }

        .mobile-menu.show {
            display: block;
        }

        .mobile-menu .menu-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px;
            border-radius: 15px;
            text-decoration: none;
            color: var(--light);
            transition: all 0.2s;
            background: rgba(255,255,255,0.03);
            margin-bottom: 8px;
        }

        .mobile-menu .menu-item:hover {
            background: var(--primary);
        }

        .mobile-menu .menu-item i {
            width: 24px;
        }

        .menu-footer {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .menu-footer .btn {
            flex: 1;
            padding: 12px;
        }

        .close-menu {
            position: absolute;
            top: 20px;
            left: 20px;
            background: none;
            border: none;
            color: var(--gray);
            font-size: 1.5rem;
            cursor: pointer;
        }

        /* ===== استجابة ===== */
        @media (max-width: 1024px) {
            .kpi-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            .nav-buttons {
                display: none;
            }

            .brand {
                position: static;
                transform: none;
                margin: 0 auto;
            }

            .hero-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .packages-grid {
                grid-template-columns: 1fr;
            }

            .route-box {
                grid-template-columns: 1fr;
                gap: 10px;
            }

            .route-arrow {
                transform: rotate(90deg);
            }

            .kpi-grid {
                grid-template-columns: 1fr;
            }

            .strip-item {
                min-width: 280px;
            }
        }

        @media (max-width: 480px) {
            .hero-grid {
                grid-template-columns: 1fr;
            }

            .hero-actions {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }

            .brand .name {
                font-size: 18px;
            }
        }
    </style>
</head>
<body>
    <header>
        <div class="container">
            <div class="nav">
                <!-- زر القائمة يسار -->
                <div class="menu-btn" id="menuBtn">
                    <i class="fas fa-bars"></i>
                </div>

                <!-- اللوجو في المنتصف -->
                <a class="brand" href="#top">
                    <div class="logo">
                        <i class="fas fa-moon"></i>
                    </div>
                    <div class="name">الحامدين للعمرة</div>
                </a>

                <!-- أزرار النافبار يمين -->
                <div class="nav-buttons">
                    <a class="nav-btn" href="https://wa.me/966564541519">
                        <i class="fab fa-whatsapp"></i> واتساب
                    </a>
                    <a class="nav-btn" href="tel:0564541519">
                        <i class="fas fa-phone"></i> اتصل
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- القائمة المنبثقة -->
    <div class="mobile-menu" id="mobileMenu">
        <button class="close-menu" id="closeMenu"><i class="fas fa-times"></i></button>
        <div style="margin-top: 20px;">
            <a href="#top" class="menu-item"><i class="fas fa-home"></i> الرئيسية</a>
